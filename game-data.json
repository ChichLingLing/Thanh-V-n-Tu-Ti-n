 "cong_thuc": {
  "kinh_nghiem_can_de_len_cap": "floor(36 * cap^1.55)",
  "quai_sinh_luc": "(40 + cap^2*1.4 + cap*30) * hpM (hpM theo từng loài, boss 4.5-5)",
  "quai_cong": "(5 + cap*2.6 + cap^2*0.035) * atkM",
  "quai_phong_ngu": "cap * 0.9",
